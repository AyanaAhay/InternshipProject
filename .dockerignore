# ===== Папки сборки .NET (их нет смысла копировать, Docker сам соберёт) =====
**/bin/
**/obj/

# ===== Папки Visual Studio =====
**/.vs/
**/.vscode/

# ===== Git =====
.git/
.gitignore
.gitattributes

# ===== Файлы пользователя Visual Studio =====
*.user
*.suo
*.userosscache
*.sln.docstates

# ===== Документация и вспомогательные файлы =====
*.md
*.http
*.txt
*.docx
*.pdf

# ===== Загруженные студентами файлы (большой объём, не нужен при сборке) =====
**/uploads/

# ===== Фронтенд (не нужен для бэкенда) =====
studentfront/

# ===== Логи =====
*.log
**/logs/

# ===== Временные файлы =====
*.tmp
*.temp

# ===== НЕ ИГНОРИРОВАТЬ (важно для сборки!) =====
# Разрешаем папку packages с NuGet пакетами
!packages/
!packages/*.nupkg

# Разрешаем nuget.config
!nuget.config
